          "rawSql": "SELECT\r\n  $__timeGroupAlias(subquery.obs_epoch,$__interval),\r\n  SUM(POWER(subquery.derivative,2)) AS \"Rapid Change\"\r\nFROM \r\n(\r\n  SELECT\r\n    o.obs_epoch,\r\n    ( o.obs_snr - LAG(o.obs_snr, 1, NULL) OVER (PARTITION BY o.sat_id, o.sat_signal ORDER BY o.obs_epoch) ) /\r\n    EXTRACT(EPOCH FROM ((o.obs_epoch - LAG(o.obs_epoch, 1, NULL) OVER (PARTITION BY o.sat_id, o.sat_signal ORDER BY o.obs_epoch))))\r\n    as derivative\r\n  FROM\r\n    observations_GLO o\r\n  JOIN\r\n      rtcm_messages r ON o.rtcm_id = r.rtcm_id\r\n  JOIN\r\n      mountpoints m ON r.mountpoint_id = m.mountpoint_id\r\n  WHERE\r\n    m.mountpoint_id = '$selected_mountpoint' AND\r\n    $__timeFilter(o.obs_epoch)\r\n) subquery\r\nGROUP BY 1",
